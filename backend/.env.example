# Copy this file to .env and fill in what you have. Defaults to a locally
# running Ollama, so the LLM-backed agents (chat, campaigns, AI buyer,
# LLM-gatekeeper) work with zero API keys and zero external calls, as long
# as `ollama serve` is running and OLLAMA_MODEL_ID is pulled locally.

# --- LLM provider (pick one) ---
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL_ID=qwen2.5:3b
# Layers offloaded to GPU, rest on CPU (hybrid). 0 = pure CPU. A large
# number/"auto" overflowed this integrated GPU's memory on load - raise this
# a lot (e.g. 999) on a machine with real dedicated VRAM for full GPU speed.
OLLAMA_NUM_GPU=8

# LLM_PROVIDER=groq
# GROQ_API_KEY=
# Optional extra keys (up to 4 total), rotated through in order on a
# rate-limit throttle, then falling over to Anthropic below if configured.
# Sticky: once a key is seen throttled, later requests skip straight past
# it instead of re-trying a key that's still going to be dead.
# GROQ_API_KEY_2=
# GROQ_API_KEY_3=
# GROQ_API_KEY_4=

# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL_ID=claude-sonnet-5

# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL_ID=gpt-4o-mini

# --- Razorpay (test mode) ---
# Leave RAZORPAY_MODE=mock to run with zero Razorpay keys (deterministic
# fake payment links, safe for a demo). Switch to "live" once you have real
# test-mode keys from the Razorpay dashboard.
RAZORPAY_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Merchant growth guardrails (hard bounds enforced by the gatekeeper) ---
MAX_SINGLE_ORDER_PAISE=500000
MAX_DISCOUNT_PERCENT=40
DAILY_CAMPAIGN_BUDGET_PAISE=2000000
MAX_CAMPAIGN_RECIPIENTS=25
MAX_ORDERS_PER_SESSION=5

DATABASE_URL=sqlite:///./agentic_commerce.db

# --- Auth ---
# Fine as the default for a local demo. Set your own before deploying anywhere real.
JWT_SECRET=dev-secret-change-me-a1b2c3-please-rotate-me
JWT_EXPIRES_MINUTES=10080
